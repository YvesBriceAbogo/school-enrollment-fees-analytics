# =====================================================
# PROJET : SUIVI DES EFFECTIFS ET DES FRAIS DE SCOLARITÉ
# AUTEUR : Brice Abogo
#
# OBJECTIF
# Exclure par défaut les données sources, modèles contenant
# potentiellement des données et fichiers locaux sensibles.
#
# IMPORTANT
# Ces règles concernent les fichiers non suivis lors des
# opérations Git ordinaires.
# Elles ne retirent ni les fichiers déjà suivis ni l'historique.
# Elles ne détectent pas le contenu sensible.
# Elles ne sécurisent pas les téléversements manuels sur GitHub.
#
# Les données réelles restent hors du dépôt public.
# =====================================================


# -----------------------------------------------------
# 1. DOSSIERS DE TRAVAIL À EXCLURE
# -----------------------------------------------------

/data/raw/
/data/private/
/data/real/
/private/
/local/


# -----------------------------------------------------
# 2. EXPORTS COMPTABLES ET FICHIERS DE DONNÉES
#
# Inclut notamment E.txt, T.txt et G.txt.
# Les motifs couvrent les variantes de casse des extensions.
#
# Aucune exception pour un jeu synthétique n'est activée.
# Une éventuelle exception devra être ciblée après examen
# des fichiers effectivement destinés à la publication.
# -----------------------------------------------------

*.[tT][xX][tT]
*.[cC][sS][vV]

*.[xX][lL][sS]
*.[xX][lL][sS][xX]
*.[xX][lL][sS][bB]
*.[xX][lL][sS][mM]


# -----------------------------------------------------
# 3. FICHIERS POWER BI
#
# Un PBIX en mode Import peut contenir les données détaillées.
# Un PBIT ne contient pas le cache des données importées,
# mais peut conserver des définitions, chemins, paramètres
# et valeurs sensibles.
# -----------------------------------------------------

*.[pP][bB][iI][xX]
*.[pP][bB][iI][tT]

# Exclusion prudente des fichiers locaux et caches .pbi.
# Cette règle ne contrôle pas les autres fichiers d'un projet.
**/.pbi/


# -----------------------------------------------------
# 4. PDF EXCLUS PAR DÉFAUT
#
# La galerie publique utilise des captures PNG.
# Aucun PDF n'est nécessaire pour la compléter.
#
# Une exception pour un PDF préparé et contrôlé pourra
# être ajoutée ultérieurement pour ce fichier précis.
# -----------------------------------------------------

*.[pP][dD][fF]


# -----------------------------------------------------
# 5. CONFIGURATION LOCALE ET SECRETS
#
# Ces règles portent sur des noms de fichiers.
# Elles ne détectent pas les secrets inscrits ailleurs.
# -----------------------------------------------------

.env
.env.*
credentials.json
secrets.json
/config/local/


# -----------------------------------------------------
# 6. ARCHIVES ET SAUVEGARDES
#
# Elles peuvent contenir des données non publiques.
# -----------------------------------------------------

*.[zZ][iI][pP]
*.7[zZ]
*.[rR][aA][rR]
*.[bB][aA][kK]
*.[bB][aA][cC][kK][uU][pP]


# -----------------------------------------------------
# 7. FICHIERS TEMPORAIRES ET JOURNAUX LOCAUX
# -----------------------------------------------------

~$*
*.[tT][mM][pP]
*.[tT][eE][mM][pP]
*.[lL][oO][gG]


# -----------------------------------------------------
# 8. FICHIERS GÉNÉRÉS PAR LE SYSTÈME
# -----------------------------------------------------

.DS_Store
Thumbs.db
Desktop.ini
desktop.ini


# -----------------------------------------------------
# DOCUMENTATION, CODE ET GALERIE
#
# Hors des dossiers exclus ci-dessus, les extensions
# .md, .pq, .dax et .png ne sont pas exclues.
#
# Les huit PNG de images/ restent utilisables dans la galerie.
#
# Ne pas être ignoré par Git ne constitue pas une autorisation
# de publication : le contenu reste à examiner avant diffusion.
# -----------------------------------------------------
